# ============================================================
# 复制为 .env 后填写。所有变量都有默认值，只有 LLM_API_KEY 必填。
# ============================================================

# ===== 大模型（OpenAI 兼容协议；本项目默认 DeepSeek）=====
# 其他可选：SiliconFlow https://api.siliconflow.cn/v1 、OpenAI https://api.openai.com/v1
LLM_API_KEY=sk-your-deepseek-api-key
# ⚠️ 本项目实测：DeepSeek 的 base_url **不带 /v1** 也能用，且模型名以 key 实际开通为准。
# 本机 key 实测可用的是 deepseek-flash / deepseek-v4-pro（网上常见的 deepseek-chat 反而不可用）。
# 换 key / 换供应商后，先用 client.models.list() 确认可用模型名，不要照抄文档。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ===== 成本核算（元 / 千 token；留 0 = 只显示 token 量不估算金额）=====
LLM_COST_PROMPT_PER_1K=0
LLM_COST_COMPLETION_PER_1K=0

# ===== LLM 熔断（依赖故障快速失败，避免每次请求都去撞墙）=====
# 连续失败 N 次打开熔断；冷却 M 秒后进入半开试探，成功则恢复
# 触发场景：供应商欠费（402）、限流（429）、网络不可达
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=60

# ===== 向量化模型（仅 RETRIEVAL_BACKEND=milvus 时需要）=====
# 注意前缀是 LLM_，与上面的对话模型共用同一份 Key
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1536

# ===== 检索策略 =====
# ragflow（默认，推荐）或 milvus
RETRIEVAL_BACKEND=ragflow
RETRIEVAL_TOP_K=4
# 低于该相似度的切片视为「资料不足」-> 兜底话术 + 转人工（防幻觉第一道防线）
# 注意：这个值**因平台而异**，不要照抄。已在本项目知识库上标定（26 条标注问题）：
#   0.53 -> 召回 94%、误检 10%（推荐）   0.54 -> 召回 81%、误检 0%（更保守）
# 换了 embedding 模型 / 知识库大改后，请重跑：python scripts/calibrate_threshold.py
RETRIEVAL_SCORE_THRESHOLD=0.53
# 同一份文档最多采用几条切片
RETRIEVAL_MAX_PER_SOURCE=2

# ===== RAGFlow（默认检索后端）=====
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_API_KEY=ragflow-your-api-key
# 可写知识库名称或 dataset id；多个用逗号分隔
RAGFLOW_DATASET_IDS=tiktok_bedding_kb
# 平台侧粗筛阈值（本地还会按 RETRIEVAL_SCORE_THRESHOLD 精筛）
RAGFLOW_SIMILARITY_THRESHOLD=0.15
# 向量相似度权重：0=纯关键词、1=纯向量。0.7 是实测最优
# （0.3 时改写类问题的相关分只有 0.23~0.49、与无关问题重叠严重；0.7 时相关分升到 0.52+，可分性最好）
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.7
RAGFLOW_PAGE_SIZE=10
RAGFLOW_TIMEOUT=30
RAGFLOW_MAX_RETRIES=3
RAGFLOW_USE_RERANK=false

# ===== Milvus（备选后端，需要 pip install -e ".[milvus]"）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=shop_knowledge
MILVUS_EMBEDDING_DIM=1536

# ===== 知识库 =====
KNOWLEDGE_BASE_DIR=data/knowledge_base
# 商品目录（数据流水线产物）：买家消息里的货源链接/商品番号 → 映射成商品注入检索词；
# 文件不存在时链接识别优雅降级为不可用（Docker 部署需挂载 ./data/raw）
CATALOG_PATH=data/raw/zhaojiafang/catalog.json

# ===== 客服业务规则 =====
SHOP_NAME=くらし寝具（Kurashi Bedding）
SHOP_NAME_JA=くらし寝具
DEFAULT_LANGUAGE=ja
SUPPORTED_LANGUAGES=ja,en,es,fr,de,ko,zh
HUMAN_INTENTS=human,refund,complaint,dispute
# 意图置信度低于该值一律转人工
CONFIDENCE_THRESHOLD=0.5
SESSION_HISTORY_TURNS=4
SESSION_TTL_SECONDS=3600

# ===== 可观测 =====
LOG_LEVEL=INFO
LOG_JSON=true
# /metrics（Prometheus 文本）访问令牌：配置后需带 X-Metrics-Token 头；留空则开放（启动会告警）
METRICS_TOKEN=
# 运行环境：production 会启用更严格校验（默认密钥 / 开放 CORS / 空管理员密码直接拒绝启动）
ENVIRONMENT=development

# ===== 运营控制台（会话 / 工单 / 反馈 / 缓存 共用一张 SQLite）=====
CONSOLE_DB_PATH=output/console/console.db
# 精确问答缓存：同问题（同语言、无上下文）直接复用，省 LLM 成本
CONSOLE_CACHE_ENABLED=true
CONSOLE_CACHE_TTL_SECONDS=3600
CONSOLE_PAGE_SIZE=20

# ===== 接口限流（令牌桶；按登录用户限流，换 IP 也限得住）=====
RATELIMIT_ENABLED=true
# 聊天：突发 10 次、长期 30 次/分钟
RATELIMIT_CHAT_BURST=10
RATELIMIT_CHAT_PER_MINUTE=30
# 登录：更严格（防脚本撞库），按来源 IP
RATELIMIT_LOGIN_BURST=5
RATELIMIT_LOGIN_PER_MINUTE=10

# ===== 鉴权与账号安全 =====
# ⚠️ 生产必改：JWT 签名密钥。留默认值等于把令牌伪造权交给所有人
AUTH_SECRET_KEY=dev-insecure-secret-change-me-in-production
# 访问令牌 60 分钟、刷新令牌 14 天（刷新即轮换，旧令牌立即作废）
AUTH_ACCESS_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=14
# 连续失败 5 次锁定 15 分钟；失败满 3 次起必须过图形验证码
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_CAPTCHA_AFTER_FAILURES=3
# 密码策略：至少 10 位，且需含字母与数字
AUTH_PASSWORD_MIN_LENGTH=10
# 是否开放自助注册；企业内网可设 false，只由管理员开号
AUTH_ALLOW_REGISTRATION=true
# 限制可注册的邮箱域名（逗号分隔，空 = 不限制）；建议生产填企业域名
AUTH_ALLOWED_EMAIL_DOMAINS=
# 首次启动自动创建的管理员；密码留空则随机生成并打印到服务端日志
AUTH_SEED_ADMIN_EMAIL=admin@kurashi-bedding.jp
AUTH_SEED_ADMIN_PASSWORD=
# 用户库（SQLite，真实持久化；已在 .gitignore 中排除）
AUTH_USERS_DB=output/auth/users.db

# ===== 跨域（前端独立域名部署时配置；同源部署可忽略）=====
# 逗号分隔；* 表示允许全部（本地开发/演示方便）。生产建议写成具体域名：
# CORS_ORIGINS=https://cs.example.com,https://admin.example.com
CORS_ORIGINS=*

# ===== 可信反向代理（决定是否采信 X-Forwarded-For）=====
# ⚠️ X-Forwarded-For 是客户端可伪造的请求头，而登录限流是按来源 IP 计的。
# 无条件采信它 = 攻击者每次换个假 IP 就能无限试密码（绕过防撞库限流）。
# 因此**默认空 = 完全不信这个头**（直连部署的正确默认值，登录限流照样生效）。
# 只有在前面确实挂了自己的 Nginx / 网关（由它覆写该头）时，才填代理自身的地址：
# TRUSTED_PROXIES=172.18.0.1,127.0.0.1
# 反代部署却留空 → 所有访客会被算成同一个 IP，登录限流会"误伤"整站。
TRUSTED_PROXIES=
